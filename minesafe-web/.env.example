# ==============================================================================
# MINESAFE WEB - VARIABLES DE ENTORNO DE EJEMPLO
# Copia este archivo como .env en la raíz de minesafe-web/ y completa tus valores.
# NUNCA agregues claves privadas en variables con prefijo VITE_.
# ==============================================================================

# URL base del servicio de análisis de IA.
# En desarrollo se recomienda usar '/api/ai' para que el proxy de Vite inyecte
# la clave privada en el servidor local sin exponerla en el navegador.
VITE_AI_ANALYSIS_API_URL=/api/ai

# Clave privada para autenticar contra POST /v1/analyze.
# OJO: Esta variable NO tiene prefijo VITE_, por lo que NO se compila en el bundle
# JavaScript del cliente. Solo la utiliza el servidor proxy de Vite o Cloud Functions.
MINESAFE_AI_API_KEY=tu-clave-secreta-generada-en-el-backend-ia

# Configuración pública de Firebase Client (Web SDK)
VITE_FIREBASE_API_KEY=AIzaSyTuClavePublicaFirebaseWebClient
VITE_FIREBASE_AUTH_DOMAIN=minefase-fc5f5.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://minefase-fc5f5-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=minefase-fc5f5
VITE_FIREBASE_STORAGE_BUCKET=minefase-fc5f5.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=873613635290
VITE_FIREBASE_APP_ID=1:873613635290:web:abcdef123456
